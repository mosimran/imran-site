---
// Shared document shell. index.astro still carries its own head and migrates
// here at T10, when the masthead changes to the Internet-Draft form.
import '../styles/rfc.css'
import { identifier } from '../lib/draft'
import { history } from '../lib/history'

/*
 * The identifier is computed from Appendix A, exactly as index.astro computes it.
 *
 * It was a literal 5 with a comment saying "keep in step with index.astro". It
 * was never kept in step. Appendix A reached 43 rows while this stayed at 5, so
 * the front page published draft-imran-systems-and-arguments-41 and every other
 * page on the site published -04, and both were live at once. A document whose
 * own identifier disagrees with itself across its own pages is the failure this
 * site is about. Erratum 7.48.
 */
const ident = identifier('systems-and-arguments', history.length)

interface Props {
  title: string
  description: string
  back?: boolean
}
const { title, description, back = true } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const cover = new URL('/og-cover.jpg', Astro.site).href
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" type="application/atom+xml" title="Position Papers" href="/feed.xml">
<link rel="alternate" type="application/atom+xml" title="Errata" href="/errata.xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Mosthofa Imran">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={cover}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={cover}>
</head>
<body>
<!-- Cloudflare Email Address Obfuscation is disabled for this document.
     It rewrites addresses and injects /cdn-cgi/scripts/../email-decode.min.js,
     which the CSP in public/_headers forbids and which would break the
     zero-JavaScript budget. The addresses here are published on purpose. -->
<!--email_off-->
<a class="skip" href="#main">Skip to document</a>
<header class="rh">
  <div class="in">
    <a class="doc" href="/"><span class="doc-long">{ident}</span><span class="doc-short">Internet-Draft</span></a>
    <nav>
      <a href="/papers/">Papers</a>
      <a href="/tools/">Tools</a>
      <a href="/errata/">Errata</a>
      <a href="/cv/">CV</a>
      <a href="/#s14">Contact</a>
      <a href="/contact.vcf" data-opt download>vCard</a>
    </nav>
  </div>
</header>
<div class="page" id="main">
  {back && <a class="back" href="/">&#8592; {ident}</a>}
  <slot />
</div>
<!--/email_off-->
</body>
</html>
