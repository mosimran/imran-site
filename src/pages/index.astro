// RFC 0001 index. Content is the handoff prototype's v-home view, verbatim,
// with the hash-router links resolved to the real URLs they will occupy.
// Those routes land at T11 and T12; until then they 404, which is expected.
//
// The masthead still reads "Request for Comments: 0001". It becomes an
// Internet-Draft identifier at T10. See docs/PLAN.md section 1.
import { getCollection } from 'astro:content'
import '../styles/rfc.css'
import { identifier, expiresOn, isExpired, fmt, fmtMonth } from '../lib/draft'
import { website } from '../lib/ld'
import { history } from '../lib/history'

// Section 3's short table, generated. It was eight hand-written rows duplicating
// the impl collection, and on 2026-09-03 that duplication published a claim the
// site had already corrected: note 3.3 was retitled and its two invented figures
// removed under erratum 7.13, and this table went on showing "Ingest path rewrite,
// PHP to Rust" and "89% fewer nodes" on the front page. An erratum that the
// homepage contradicts is worse than no erratum. Same fix as Appendix A: one
// source, two surfaces.
const impl = (await getCollection('impl'))
  .sort((a, b) => Number(a.data.section.split('.')[1]) - Number(b.data.section.split('.')[1]))
const chip = (s: string) => (s === 'production' ? 'ok' : s === 'retired' ? 'bad' : s === 'unwritten' ? '' : 'warn')
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

const canonical = new URL(Astro.url.pathname, Astro.site).href
const cover = new URL('/og-cover.jpg', Astro.site).href

const revised = new Date(history[0].date)
const ident = identifier('systems-and-arguments', history.length)
const expires = expiresOn(revised)
const expired = isExpired(revised)
