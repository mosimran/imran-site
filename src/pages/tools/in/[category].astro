---
import type { GetStaticPaths } from 'astro'
import Doc from '../../../layouts/Doc.astro'
import Star from '../../../components/Star.astro'
import '../../../styles/tools.css'
import { categories, bySlug, used, starOf, checked } from '../../../lib/tools'

export const getStaticPaths = (() => {
  return categories.map((c) => ({ params: { category: c.key }, props: { c } }))
}) satisfies GetStaticPaths

const { c } = Astro.props
const list = c.tools
/*
 * There is no graph here, and the data is the reason.
 *
 * An edge would have been one entry naming another in the same category.
 * Measured across the whole catalogue: eight of the fourteen categories have no
 * internal edges at all, five of the remaining six have between two and four
 * connected tools, and the only category with a real shape, ai-assistants at 19
 * nodes, was the one the old 16-node cap excluded. The rule admitted every
 * drawing not worth making and rejected the only one that was, so `docs`
 * published a two-node vertical line occupying 350px of the page.
 *
 * The paragraph beside it defined what an edge was, which tells a reader about
 * the drawing rather than about the tools. Removed on 2026-09-05. `mentions`
 * still earns its keep on a tool's own page, where naming the two or three
 * things an entry mentions is a fact rather than a picture.
 */
const usedHere = used.filter((u) => u.category === c.key)
const dead = list.filter((t) => !t.live.ok).length
const usedLine = usedHere.length === 0
  ? 'None of them is used to build this site.'
  : `${usedHere.length} ${usedHere.length === 1 ? 'is' : 'are'} used to build this site, starred with the file that proves it.`
---
<Doc title={`${c.label}, tools`} description={`${c.tools.length} tools catalogued under ${c.label.toLowerCase()}. ${c.blurb}`}>
  <div class="mast">
    <div>Off the Bit
<b>Tools: {c.label}</b>
Category: Catalogue
Count: {c.tools.length} catalogued{dead > 0 && `, ${dead} not answering`}</div>
    <div class="r"><b>M. Imran</b>
Index: <a href="/">draft</a>
All tools: <a href="/tools/">catalogue</a></div>
  </div>

  <div class="title">
    <h1>{c.label}</h1>
    <div class="sub">{c.blurb}</div>
  </div>

  <div class="ind tsec">
    <div class="memo">{c.tools.length} tools, described from their own homepages and last
      checked {checked}.{dead > 0 && ` ${dead} of those homepages did not answer.`} {usedLine}
      {' '}A row is a description, not an endorsement.</div>
  </div>

  {usedHere.length > 0 && (
    <div class="ind tsec">
      <h2 id="used">Used here, in this category</h2>
      <ul class="tl">
        {usedHere.map((u) => (
          <li>
            <div class="h"><Star title={u.evidence} /><a href={u.url} target="_blank" rel="noopener">{u.name}</a><span class="trole">{u.role}</span></div>
            {u.note && <div class="d">{u.note}</div>}
            <div class="tev"><b>Evidence:</b> {u.evidence}</div>
          </li>
        ))}
      </ul>
    </div>
  )}


  <div class="ind tsec">
    <h2 id="list">All {c.tools.length}</h2>
    <p class="prose">Alphabetical. Checked on {checked}; anything that did not answer says so.</p>
    <ul class="tl">
      {list.map((t) => (
        <li>
          <div class="h">
            {starOf(t.slug) && <Star title={starOf(t.slug)!.reason} />}
            <a href={`/tools/${t.slug}/`} class={t.live.ok ? undefined : 'gone-link'}>{t.name}</a>
            {!t.live.ok && <span class="gone">{t.live.reason}</span>}
          </div>
          <div class="d">{t.desc}</div>
          <div class="punch">{t.punch}</div>
          {starOf(t.slug) && <div class="tev"><b>Used here:</b> {starOf(t.slug)!.reason}</div>}
        </li>
      ))}
    </ul>
  </div>

  <div class="ind tsec">
    <h2 id="other">Other shelves</h2>
    <div class="tcats">
      {categories.filter((x) => x.key !== c.key).map((x) => (
        <a class="tcat" href={`/tools/in/${x.key}/`}>
          <span class="n">{x.tools.length}</span><b>{x.label}</b></a>
      ))}
    </div>
  </div>

  <div class="foot"><span>Imran</span><span>Tools</span><span>[{c.label}]</span></div>
</Doc>
