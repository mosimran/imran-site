---
import type { GetStaticPaths } from 'astro'
import Doc from '../../layouts/Doc.astro'
import Star from '../../components/Star.astro'
import '../../styles/tools.css'
import { tools, neighbours, categoryOf, used, starOf, checked, type Tool } from '../../lib/tools'

/*
 * A page for every tool, all 591.
 *
 * The first version generated pages only where there was more than a one-line
 * quote to show, which at the time meant 126 of them. When the descriptions
 * became written rather than quoted, the condition that selected those 126 was
 * removed, and rebuilding silently dropped pages that were already published:
 * /tools/warp/ had been live and returned 404.
 *
 * URLs on this site never change. A generation rule that can narrow is a rule
 * that can break a published address, so there is no rule now. Every tool has a
 * page, every page has a description written for it, and the set can only grow.
 */
export const getStaticPaths = (() => {
  return tools.map((t) => ({ params: { slug: t.slug }, props: { t } }))
}) satisfies GetStaticPaths

const { t } = Astro.props as { t: Tool }
const cat = categoryOf.get(t.category)
const { named, namedBy, shelf } = neighbours(t)
const mine = used.find((u) => u.catalogue === t.slug)
const star = starOf(t.slug)
const top = shelf.slice(0, 8)
---
<Doc title={`${t.name}, tools`} description={`${t.desc} ${t.punch}`}>
  <div class="mast">
    <div>Off the Bit
<b>Tools: {t.name}</b>
Category: <a href={`/tools/in/${t.category}/`}>{cat?.label ?? t.category}</a>
Site: {t.live.ok ? <a href={t.url} rel="noopener">{t.host}</a> : <span class="gone">{t.host}</span>}</div>
    <div class="r"><b>M. Imran</b>
Index: <a href="/">draft</a>
All tools: <a href="/tools/">catalogue</a></div>
  </div>

  <div class="title">
    <h1>{star && <Star title={star.reason} />} {t.name}</h1>
    <div class="sub">{t.desc}</div>
  </div>

  <div class="ind tsec">
    <p class="punchline">{t.punch}</p>
  </div>

  {!t.live.ok && (
    <div class="ind tsec">
      <div class="memo warnbox"><b>This one did not answer.</b> Asked on {checked}, and
        {' '}{t.live.reason}. The entry stays because nothing here is deleted, and because a tool
        that has gone is worth knowing about. The link above is not live.</div>
    </div>
  )}

  <div class="ind tsec">
    <h2 id="use">What it is sold for</h2>
    <p class="prose">{t.use}</p>
    {t.live.movedTo && (
      <p class="prose dim">The address redirects to <span class="kw">{t.live.movedTo}</span>,
        which is worth knowing before you follow it.</p>
    )}
  </div>

  {mine && (
    <div class="ind tsec">
      <h2 id="used">Used to build this site</h2>
      <ul class="tl"><li>
        <div class="h"><Star title={mine.evidence} /><a href={mine.url} rel="noopener">{mine.name}</a><span class="trole">{mine.role}</span></div>
        {mine.note && <div class="d">{mine.note}</div>}
        <div class="tev"><b>Evidence:</b> {mine.evidence}</div>
      </li></ul>
    </div>
  )}

  {(named.length > 0 || namedBy.length > 0) && (
    <div class="ind tsec">
      <h2 id="near">Named alongside</h2>
      <p class="prose">These entries mention each other by name. It is a weak relationship and it is
        the only one the catalogue can show without inventing something.</p>
      {named.length > 0 && (
        <>
          <p class="prose"><b>Names:</b></p>
          <ul class="tl">{named.map((n) => (
            <li><div class="h">{starOf(n.slug) && <Star title={starOf(n.slug)!.reason} />}<a href={`/tools/${n.slug}/`}>{n.name}</a></div><div class="d">{n.desc}</div></li>
          ))}</ul>
        </>
      )}
      {namedBy.length > 0 && (
        <>
          <p class="prose"><b>Named by:</b></p>
          <ul class="tl">{namedBy.map((n) => (
            <li><div class="h">{starOf(n.slug) && <Star title={starOf(n.slug)!.reason} />}<a href={`/tools/${n.slug}/`}>{n.name}</a></div><div class="d">{n.desc}</div></li>
          ))}</ul>
        </>
      )}
    </div>
  )}

  <div class="ind tsec">
    <h2 id="shelf">Same shelf</h2>
    <p class="prose">The rest of {cat?.label.toLowerCase() ?? t.category}, alphabetically. Sharing a
      category is a filing decision, not a relationship.</p>
    <ul class="tl">
      {top.map((n) => (
        <li>
          <div class="h">
            {starOf(n.slug) && <Star title={starOf(n.slug)!.reason} />}
            <a href={`/tools/${n.slug}/`}>{n.name}</a>
            {!n.live.ok && <span class="gone">did not answer</span>}
          </div>
          <div class="d">{n.desc}</div>
        </li>
      ))}
    </ul>
    <p class="prose"><a href={`/tools/in/${t.category}/`}>All {cat?.tools.length} in {cat?.label.toLowerCase()}</a></p>
  </div>

  <div class="foot"><span>Imran</span><span>Tools</span><span>[{t.name}]</span></div>
</Doc>
