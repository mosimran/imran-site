---
import type { GetStaticPaths } from 'astro'
import Doc from '../../layouts/Doc.astro'
import '../../styles/tools.css'
import { tools, neighbours, categoryOf, sourceById, used, type Tool } from '../../lib/tools'

/*
 * A page per tool, but not for all 591 of them. A page exists when there is
 * something on it beyond a one-line quote: the tool appears in more than one
 * source list, or it names another tool, or another names it. The remaining
 * rows are listed on their category page with a link straight to the vendor,
 * which is where a reader wants to go anyway.
 *
 * These are URLs, so they never change once published. A tool that later gains
 * a second citation gains a page; one that loses it keeps the page it had.
 */
export const getStaticPaths = (() => {
  const usedSlugs = new Set(used.map((u) => u.catalogue).filter(Boolean) as string[])
  return tools
    .filter((t) => t.refs.length > 1 || t.mentions.length > 0 || t.mentionedBy.length > 0 || usedSlugs.has(t.slug))
    .map((t) => ({ params: { slug: t.slug }, props: { t } }))
}) satisfies GetStaticPaths

const { t } = Astro.props as { t: Tool }
const cat = categoryOf.get(t.category)
const { named, namedBy, shelf } = neighbours(t)
const mine = used.find((u) => u.catalogue === t.slug)
const cited = t.refs.map((r) => sourceById.get(r)!).filter(Boolean)
const quotedFrom = sourceById.get(t.descFrom)
const top = shelf.slice(0, 8)
---
<Doc title={`${t.name}, tools catalogue`} description={`${t.desc} Catalogued under ${cat?.label ?? t.category}, cited by ${t.refs.length} of three source lists.`}>
  <div class="mast">
    <div>Off the Bit
<b>Tools: {t.name}</b>
Category: <a href={`/tools/in/${t.category}/`}>{cat?.label ?? t.category}</a>
Cited by: {t.refs.length} of 3 lists</div>
    <div class="r"><b>M. Imran</b>
Index: <a href="/">draft</a>
All tools: <a href="/tools/">catalogue</a></div>
  </div>

  <div class="title">
    <h1>{t.name}</h1>
    <div class="sub">{t.desc}</div>
  </div>

  <div class="ind tsec">
    <div class="memo">That description is quoted from
      {' '}<a href={quotedFrom?.url} rel="noopener">{quotedFrom?.title}</a>, not written here.
      {mine
        ? ' This tool is also used to build or serve this site, and the evidence is below.'
        : ' Its presence in this catalogue records that a public list carries it. It does not record that anyone here uses it.'}</div>
  </div>

  {mine && (
    <div class="ind tsec">
      <h2 id="used">Used here</h2>
      <ul class="tl"><li>
        <div class="h"><a href={mine.url} rel="noopener">{mine.name}</a><span class="trole">{mine.role}</span></div>
        {mine.note && <div class="d">{mine.note}</div>}
        <div class="tev"><b>Evidence:</b> {mine.evidence}</div>
      </li></ul>
    </div>
  )}

  <div class="ind tsec">
    <h2 id="where">Where it is listed</h2>
    <ul class="tsrc">
      {cited.map((s) => (
        <li><b><a href={s.url} rel="noopener">{s.title}</a></b><br />
          filed under {t.headings.join(', ')}. Read at <span class="kw">{s.commitShort}</span> of {s.commitDate}.
          Licence: <a href={s.licenceUrl} rel="noopener">{s.licence}</a>.</li>
      ))}
    </ul>
    <p class="prose"><a href={t.url} rel="noopener">{t.url}</a></p>
    {t.alsoAt && t.alsoAt.length > 0 && (
      <p class="prose dim">Also listed at {t.alsoAt.join(', ')}. Merged into one entry during
        ingest, because the source lists carried the same product under different URLs.</p>
    )}
    {t.alsoFiledUnder.length > 0 && (
      <p class="prose dim">One source files it under
        {' '}{t.alsoFiledUnder.map((c) => categoryOf.get(c)?.label ?? c).join(' and ')} instead.</p>
    )}
  </div>

  {(named.length > 0 || namedBy.length > 0) && (
    <div class="ind tsec">
      <h2 id="near">Named alongside</h2>
      <p class="prose">An edge means one description mentions the other tool by name. It is the only
        relationship these lists actually encode, and it is a weak one.</p>
      {named.length > 0 && (
        <>
          <p class="prose"><b>Its description names:</b></p>
          <ul class="tl">{named.map((n) => (
            <li><div class="h"><a href={`/tools/${n.slug}/`}>{n.name}</a></div><div class="d">{n.desc}</div></li>
          ))}</ul>
        </>
      )}
      {namedBy.length > 0 && (
        <>
          <p class="prose"><b>Named by:</b></p>
          <ul class="tl">{namedBy.map((n) => (
            <li><div class="h"><a href={`/tools/${n.slug}/`}>{n.name}</a></div><div class="d">{n.desc}</div></li>
          ))}</ul>
        </>
      )}
    </div>
  )}

  <div class="ind tsec">
    <h2 id="shelf">Same shelf</h2>
    <p class="prose">The rest of {cat?.label.toLowerCase() ?? t.category}, most-cited first. Sharing
      a category is not a relationship, only a filing decision made upstream.</p>
    <ul class="tl">
      {top.map((n) => (
        <li>
          <div class="h">
            {(n.refs.length > 1 || n.mentions.length > 0 || n.mentionedBy.length > 0)
              ? <a href={`/tools/${n.slug}/`}>{n.name}</a>
              : <a href={n.url} rel="noopener">{n.name}</a>}
            {n.refs.length > 1 && <span class="tref">{n.refs.length} of 3 lists</span>}
          </div>
          <div class="d">{n.desc}</div>
        </li>
      ))}
    </ul>
    <p class="prose"><a href={`/tools/in/${t.category}/`}>All {cat?.tools.length} in {cat?.label.toLowerCase()}</a></p>
  </div>

  <div class="foot"><span>Imran</span><span>Tools</span><span>[{t.name}]</span></div>
</Doc>
