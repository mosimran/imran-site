---
/*
 * The star, drawn rather than typed.
 *
 * It was a ★ glyph first. axe returns `incomplete` for colour contrast on any
 * element whose content is only a symbol character ("Element content contains
 * only non-text characters", messageKey nonBmp), pa11y reports that as an
 * error, and scripts/check-a11y.mjs counts it because its existing exception
 * covers text inside <svg> and nothing else. Sixty-four of them across the
 * tools pages, in both colour schemes.
 *
 * Widening that exception would have been the wrong repair. axe declines to
 * judge a symbol for a different reason than it declines to judge text on a
 * drawn backdrop, and filing one under the other is the kind of adjacent
 * measurement the errata on this site keep naming. An <svg> with no <text> in
 * it carries no contrast result at all, so there is nothing to excuse.
 *
 * `title` is the reason the star was earned. It is a real <title> element, so
 * it is the accessible name rather than a tooltip a phone cannot show, and the
 * same reason is printed as visible text next to every star on a list page.
 */
interface Props { title: string }
const { title } = Astro.props
---
<svg class="star" viewBox="0 0 24 24" width="14" height="14" role="img" aria-label={title}>
  <title>{title}</title>
  <path fill="currentColor" d="M12 1.6l3.1 6.7 7.1 1-5.2 5.1 1.3 7.3-6.3-3.4-6.3 3.4 1.3-7.3-5.2-5.1 7.1-1z" />
</svg>
